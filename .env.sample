# RSVPex — Sanitized environment variable reference
# Copy to .env for local development (never commit .env)

# ── Cloudflare ──────────────────────────────────────────
# Wrangler uses .dev.vars (not .env) for Worker secrets.
# See app/.dev.vars.sample for the Worker-specific secrets.
# These are for local tooling / CI:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Web3Forms (static site contact form) ────────────────
WEB3FORMS_ACCESS_KEY=

# ── Optional public analytics tag ───────────────────────
# Optional GA4 measurement ID for static marketing pages and public RSVP pages.
# Leave empty to keep production tag-free until configured.
GA4_MEASUREMENT_ID=
