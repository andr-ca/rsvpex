{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rsvpex-app",
  "main": "src/index.ts",
  // D-7 in recommendations.md: was pinned to 2025-01-01 (over a year stale
  // at time of audit). `nodejs_compat` is only needed for `qrcode`'s
  // pngjs/zlib usage — bumped deliberately, not left to drift again.
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Provisioned on the free tier, same Cloudflare account as the
  // rsvpex.com zone and the static-site Pages deploy (2026-07-09).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rsvpex-db",
      "database_id": "d381987e-0099-4bd7-8208-55903aebab4c",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      // Used only by the RSVP-submission rate limiter (middleware/rateLimit.ts).
      // Admin sessions live in D1, not KV — see STATE.md Key Decisions.
      "binding": "RATE_LIMIT_KV",
      "id": "522d1f8cc19744e692a9391bfb144fd3"
    }
  ],

  // Routes rsvpex.com/rsvp/* to this Worker; every other path on the zone
  // (the marketing "Coming Soon" page) keeps being served by Cloudflare
  // Pages. Requires the deploying API token to have Zone > Workers Routes >
  // Edit on the rsvpex.com zone — if deploy-app.yml fails here, that's the
  // permission to add to the CLOUDFLARE_API_TOKEN GitHub secret.
  "routes": [{ "pattern": "rsvpex.com/rsvp/*", "zone_name": "rsvpex.com" }],

  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATIONS_QUEUE",
        "queue": "rsvpex-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "rsvpex-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "rsvpex-notifications-dlq"
      }
    ]
  },

  // Fires once daily at 06:00 UTC (D-8 in recommendations.md). This is a
  // fixed UTC instant, not "6am event-local time" — combined with C-5's
  // timezone normalization, reminder_days_before now counts correctly, but
  // hosts far from UTC should know reminder emails always go out at the
  // same UTC hour regardless of the event's own timezone.
  "triggers": {
    "crons": ["0 6 * * *"]
  },

  // TURNSTILE_SITE_KEY and DEPLOYMENT_DOMAIN are public (embedded in HTML / equal to the
  // browser's own address bar) — vars, not secrets. DEPLOYMENT_DOMAIN gates the CSRF Origin
  // check (middleware/csrf.ts) and is used to build absolute links in outbound emails/SMS
  // (handlers/queue.ts) instead of a hardcoded hostname; it MUST be set before deploying.
  // TURNSTILE_SECRET_KEY, SETUP_SECRET, IP_HASH_KEY, ARGON2_PEPPER and the Resend/Twilio
  // credentials are secrets — set via `wrangler secret put <NAME>` for production, or in
  // .dev.vars for local development. Do NOT declare secret names in `vars`: an empty var of
  // the same name shadows the real secret at runtime.
  // ENVIRONMENT gates the 'test-secret' bypasses in middleware/turnstile.ts and
  // middleware/rateLimit.ts (S-1 in recommendations.md): the bypass now requires
  // BOTH the magic secret value AND ENVIRONMENT !== 'production', so a prod
  // deploy can never disable CAPTCHA/rate-limiting just because a secret was
  // accidentally set to the test literal.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAADyl3LcpKCh2BO-G",
    "DEPLOYMENT_DOMAIN": "https://rsvpex.com",
    "GA4_MEASUREMENT_ID": "",
    "ENVIRONMENT": "production"
  }
}
