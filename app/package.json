{
  "name": "@rsvpex/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply rsvpex-db --local",
    "migrate:remote": "wrangler d1 migrations apply rsvpex-db --remote",
    "types": "wrangler types",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'tests/**/*.ts'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "hono": "4.12.28",
    "ical-generator": "^10.1.0",
    "qrcode": "^1.5.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vitest-pool-workers": "0.13.3",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@playwright/test": "^1.61.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "4.1.0",
    "wrangler": "4.76.0"
  }
}
