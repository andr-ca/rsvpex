{
  "name": "@rsvpex/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply rsvpex-db --local",
    "migrate:remote": "wrangler d1 migrations apply rsvpex-db --remote",
    "types": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.6",
    "@noble/hashes": "2.0.1",
    "drizzle-orm": "0.45.1",
    "hono": "4.12.8",
    "ical-generator": "^10.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.13.3",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "4.1.0",
    "wrangler": "4.76.0"
  }
}
